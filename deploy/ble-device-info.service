# 部署示例：systemd 服务（可选，程序本身不依赖系统服务）
# 安装：sudo cp ble-device-info.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now ble-device-info
[Unit]
Description=BLE Device Info Peripheral
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ble-device-info
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
